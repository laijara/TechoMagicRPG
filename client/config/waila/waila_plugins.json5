    // Черный список
    // Пользовательская конфигурация, откройте следующий файл §7* (Custom config, open the following file)
    // extra\fluid_blacklist.json5
    "fluid.blacklist": null,
    // Содержание блоков
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "item.enabled_block": true,
    // Содержимое сущностей
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "item.enabled_entity": true,
    // Синхронизировать NBT данные
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "item.nbt": true,
    // Режим отображения
    // Сетка: отображение подобно интерфейсу контейнера
    // Список: отображение в виде списка
    // Динамически: до заданной высоты отображение в виде сетки, дальше, в виде списка
    // Значение по умолчанию: [DYNAMIC] §7* (Default value: [%s])
    // Доступные значения: [GRID, LIST, DYNAMIC] §7* (Available values: [%s])
    "item.display_mode": "DYNAMIC",
    // Максимальная высота
    // Значение по умолчанию: [3] §7* (Default value: [%s])
    "item.max_height": 3,
    // Сортировать по количеству
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "item.sort_by_count": true,
    // Масштаб режима сетки §7* (Grid Mode Scale)
    // Значение по умолчанию: [1.0] §7* (Default value: [%s])
    "item.grid_mode_scale": 1.0,
    // Черный список
    // Пользовательская конфигурация, откройте следующий файл §7* (Custom config, open the following file)
    // extra\item_blacklist.json5
    "item.blacklist": null,
    // Процесс крафта блоков
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "progress.enabled_block": true,
    // Процесс крафта сущностей
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "progress.enabled_entity": true,
    // Показать расчетное время §7* (Show Estimated Time)
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "progress.time": true,
    // Подсказка «Заменить элемент» §7* (Replace Item Tooltip)
    // Если этот параметр включен, замените всплывающую подсказку по элементу, если в рецепте есть ввод и/или вывод элемента. Если не включено или нет ввода и вывода элементов, отображается только индикатор выполнения. §7* (If enabled, replace item tooltip when the recipe has item input and/or output. If not enabled or no item input and output, only shows a progress bar.)
    // Значение по умолчанию: [false] §7* (Default value: [%s])
    "progress.replace_items": false,
    // Высота индикатора выполнения §7* (Progress Bar Height)
    // Только тогда, когда он отображается в виде полосы, а не стрелки. §7* (Only for when it shown as a bar and not an arrow)
    // Значение по умолчанию: [1] §7* (Default value: [%s])
    "progress.height": 1,
    // Черный список
    // Пользовательская конфигурация, откройте следующий файл §7* (Custom config, open the following file)
    // extra\progress_blacklist.json5
    "progress.blacklist": null
  }
}