{
  vampirism: {
    // config.waila.plugin_vampirism.show_creature_info
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    show_creature_info: true,
    // config.waila.plugin_vampirism.show_player_info
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    show_player_info: true,
    // config.waila.plugin_vampirism.blood.long_max
    // Значение по умолчанию: [100] §7* (Default value: [%s])
    "blood.long_max": 100
  },
  treechop: {
    // Block counts
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    show_tree_block_counts: true,
    // Chop counts
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    show_num_chops_remaining: true
  },
  waila: {
    // Отображать блоки
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    show_blocks: true,
    // Отображать жидкости
    // Попытается отображать жидкости
    // Значение по умолчанию: [false] §7* (Default value: [%s])
    show_fluids: false,
    // Отображать сущности
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    show_entities: true,
    // Отображать иконки
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    show_icon: true,
    // Положение иконки
    // Значение по умолчанию: [MIDDLE] §7* (Default value: [%s])
    // Доступные значения: [TOP, MIDDLE, BOTTOM] §7* (Available values: [%s])
    icon_position: "MIDDLE",
    // Отображать названия модов
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    show_mod_name: true,
    // Отображать названия мода для предеметов
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    show_item_mod_name: true,
    // Отображать названия из регистра
    // Значение по умолчанию: [false] §7* (Default value: [%s])
    show_registry: false
  },
  minecraft: {
    // Отображать позицию блока
    // Значение по умолчанию: [false] §7* (Default value: [%s])
    "block.position": false,
    // Отображать состояние блока
    // Значение по умолчанию: [false] §7* (Default value: [%s])
    "block.state": false,
    // Отображать сущности предметов
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "entity.item_entity": true,
    // Отображать сущности
    // Значение по умолчанию: [false] §7* (Default value: [%s])
    "entity.position": false,
    // Отображать очки жизни
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "entity.health": true,
    // Отображать очки поглощения
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "entity.absorption": true,
    // Отображать очки брони
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "entity.armor": true,
    // Компактный режим
    // Отображать очки жизней и брони цифрами а не иконками
    // Значение по умолчанию: [false] §7* (Default value: [%s])
    "entity.compact": false,
    // Максимум инокок на строку
    // Количество иконок жизни и брони в строке перед началом следующей
    // Значение по умолчанию: [25] §7* (Default value: [%s])
    "entity.icon_per_line": 25,
    // Максимум очков жизни для отображения
    // Наибольшее число очков жизни для отображения в виде иконок, если у моба или игрока больше чем указано здесь, будут отображены цифры
    // Значение по умолчанию: [100] §7* (Default value: [%s])
    "entity.long_health_max": 100,
    // Максимум очков брони для отображения
    // Наибольшее число очков брони для отображения в виде иконок, если у моба или игрока больше чем указано здесь, будут отображены цифры
    // Значение по умолчанию: [100] §7* (Default value: [%s])
    "entity.long_armor_max": 100,
    // Отображать владельца
    // Только для лицензионных аккаунтов Minecraft
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "pet.owner": true,
    // Скрыть если владелец неизвестен
    // Значение по умолчанию: [false] §7* (Default value: [%s])
    "pet.hide_unknown_owner": false,
    // Отображать силу прыжка лошади
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "horse.jump_height": true,
    // Отображать скорость лошади
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "horse.speed": true,
    // Показывать характер панд
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "panda.genes": true,
    // Отображать координаты улья
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "bee.hive_pos": true,
    // Отображать уровень мёда
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
