    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "breaking_progress.enabled": true,
    // Цвет индикатора ломания
    // Значение по умолчанию: [-1426063361] §7* (Default value: [%s])
    "breaking_progress.color": -1426063361,
    // Только снизу
    // Значение по умолчанию: [false] §7* (Default value: [%s])
    "breaking_progress.bottom_only": false,
    // Отображать тип спаунера
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "spawner.type": true,
    // Отображать зрелость урожая
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "plant.crop_progress": true,
    // Отображать возможность роста культур
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "plant.crop_growable": true,
    // Отображать возможность роста деревьев
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "plant.tree_growable": true,
    // Отображать положение рычага
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "redstone.lever": true,
    // Отображать задержку повторителя
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "redstone.repeater": true,
    // Отображать режим компаратора
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "redstone.comparator": true,
    // Отображать уровень сигнала
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "redstone.level": true,
    // Отображать уровень компоста
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "level.composter": true,
    // Отображать инструмент и ноту
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "note_block.type": true,
    // Режим отображения нот
    // Значение по умолчанию: [SHARP] §7* (Default value: [%s])
    // Доступные значения: [SHARP, FLAT] §7* (Available values: [%s])
    "note_block.note": "SHARP",
    // Число
    // Значение по умолчанию: [false] §7* (Default value: [%s])
    "note_block.int_value": false,
    // Показывать число книг на полке
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "book.bookshelf": true,
    // Отображение зачарований
    // Значение по умолчанию: [CYCLE] §7* (Default value: [%s])
    // Доступные значения: [SEPARATE, COMBINED, CYCLE, DISABLED] §7* (Available values: [%s])
    "book.enchantment": "CYCLE",
    // Время цикла (в миллисекундах)
    // Значение по умолчанию: [500] §7* (Default value: [%s])
    "book.enchantment_cycle_timing": 500,
    // Показывать автора и дату записанных книг
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "book.written": true
  },
  harvest: {
    // Отображать информацию для добычи
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
