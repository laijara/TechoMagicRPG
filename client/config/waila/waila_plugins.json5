    enabled: true,
    // Режим отображения
    // Значение по умолчанию: [MODERN] §7* (Default value: [%s])
    // Доступные значения: [MODERN, CLASSIC, CLASSIC_MINIMAL] §7* (Available values: [%s])
    display_mode: "MODERN",
    // Отображать в творческом режиме
    // Значение по умолчанию: [false] §7* (Default value: [%s])
    creative: false
  },
  wailax: {
    // Энергия блоков
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "energy.enabled_block": true,
    // Энергию сущностей
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "energy.enabled_entity": true,
    // Черный список
    // Пользовательская конфигурация, откройте следующий файл §7* (Custom config, open the following file)
    // extra\energy_blacklist.json5
    "energy.blacklist": null,
    // Жидкости в блоках
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "fluid.enabled_block": true,
    // Жидкости в сущностях
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "fluid.enabled_entity": true,
    // Единицы измерения
    // Значение по умолчанию: [MILLIBUCKETS] §7* (Default value: [%s])
    // Доступные значения: [MILLIBUCKETS, DROPLETS] §7* (Available values: [%s])
