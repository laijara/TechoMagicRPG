    // Отображать количество пчел в улье и пасеке
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "bee.hive_occupants": true,
    // Показать эффекты маяков
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "effect.beacon": true,
    // Показать эффекты мобов
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "effect.mob": true,
    // Показать скрытые эффекты мобов
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [false] §7* (Default value: [%s])
    "effect.hidden_mob": false,
    // Отображать играющую пластинку
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "jukebox.record": true,
    // Отображать таймер роста мобов
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "timer.grow": true,
    // Отображать таймер размножения
    // Требовать, чтобы на сервере был установлен WTHIT, в противном случае он будет заблокирован на [false] §7* (Require server to have WTHIT installed, if not, will be locked to [%s])
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "timer.breed": true,
    // Скрывать невидимые сущности
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "override.invisible_entity": true,
    // Отображать сундук-ловушку как обычный сундук
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "override.trapped_chest": true,
    // Отображать рыхлый снег как обычный
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "override.powder_snow": true,
    // Отображать заражённые блоки как обычные
    // Это значение будет объединено со значением с сервера. §7* (This value will get merged with the value from the server)
    // Значение по умолчанию: [true] §7* (Default value: [%s])
    "override.infested": true,
    // Скрыть транспорт
    // Скрывать вагонетки, лошадей и прочие сущности, если игрок сидит на них
    // Значение по умолчанию: [true] §7* (Default value: [%s])
